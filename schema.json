{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Security Event Schema",
  "$comment": "Confidence uses a scale from 0.0 to 1.0. Approval and confidence are mandatory because security decisions must record both the system's confidence and approval state.",

  "type": "object",

  "properties": {
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "event_id",
        "timestamp",
        "source",
        "event_type",
        "severity"
      ]
    },

    "enrichment": {
      "type": "object",
      "properties": {
        "threat_intel_matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_context": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string"
            },
            "ip_address": {
              "type": "string"
            }
          }
        },
        "related_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "threat_intel_matches",
        "asset_context",
        "related_events"
      ]
    },

    "confidence": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "level",
        "applies_to"
      ]
    },

    "approval": {
      "type": "object",
      "properties": {
        "approval_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "auto-approved"
          ]
        },
        "approver_id": {
          "type": "string"
        },
        "approval_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "approval_status",
        "approver_id",
        "approval_timestamp"
      ]
    },

    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "actor",
          "action",
          "timestamp"
        ]
      },
      "minItems": 1
    }
  },

  "required": [
    "event",
    "enrichment",
    "confidence",
    "approval",
    "audit_trail"
  ]
}